{
  "name": "@loongserpent/dsh-client-ui-workspace-drag-drop",
  "version": "0.1.0-rc.8",
  "description": "Drag-and-drop plugin for adding workspaces by dropping folders onto the DeepSeek Harness sidebar",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loongserpent/deepseek-harness.git",
    "directory": "packages/client/ui-workspace-drag-drop"
  },
  "homepage": "https://github.com/loongserpent/deepseek-harness/tree/main/packages/client/ui-workspace-drag-drop#readme",
  "bugs": {
    "url": "https://github.com/loongserpent/deepseek-harness/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "workspace",
    "drag-drop",
    "ui-plugin"
  ],
  "author": "DeepSeek AI",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "id": "ui-workspace-drag-drop",
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "prepublishOnly": "npm run bundle",
    "version": "npm run bundle",
    "postversion": "git push && git push --tags"
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-locale": "workspace:^",
    "@deepseek-ai/dsh-client-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.12.9",
    "typescript": "~5.9.2"
  },
  "files": [
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
